# Wygenerowane przez scripts/produkcja.mjs – NIE edytować na serwerze (przy następnej wrzucie zniknie).
# Źródło reguł 301: public/_redirects + scripts/przekierowania.mjs (te same co na Netlify).
Options -Indexes -MultiViews
DirectoryIndex index.html
# katalog i strona o tej samej nazwie (np. /szkolenia-pabianice i szkolenia-pabianice/): bez dopisywania „/” przez Apache
DirectorySlash Off
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest

RewriteEngine On
RewriteBase /

# 0. OVH wdraża przez git clone – katalog .git leży w katalogu strony; nie udostępniamy go (ani innych plików z kropką poza .well-known)
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# 1. ewa-gabinet.pl → www (jak na starej stronie), http → https (sposób z dokumentacji OVH: port 80)
RewriteCond %{HTTP_HOST} ^ewa-gabinet\.pl$ [NC]
RewriteRule ^(.*)$ https://www.ewa-gabinet.pl/$1 [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.ewa-gabinet\.pl$ [NC]
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^(.*)$ https://www.ewa-gabinet.pl/$1 [R=301,L,NE]

# 2. adresy innej domeny niż www.ewa-gabinet.pl (podgląd przed przepięciem, adres techniczny OVH): robots z Disallow
RewriteCond %{HTTP_HOST} !^www\.ewa-gabinet\.pl$ [NC]
RewriteRule ^robots\.txt$ robots-test.txt [L]

