# 4. stare zakończenia: /index.html → /, /strona.html → /strona (tylko prośby z przeglądarki, nie wewnętrzne przepisanie)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(.*/)?index\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^?\s]+)\.html[\s?]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,NE]

# 5. bez końcowego „/” (trailingSlash: 'never' w astro.config.mjs – adresy jak na starej stronie)
RewriteCond %{REQUEST_URI} ^/.+/$
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L,NE]

# 6. /o-nas → o-nas.html (wewnętrznie, adres w pasku bez .html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_headers.c>
  # podgląd i adres techniczny: nie indeksować
  <If "tolower(%{HTTP_HOST}) != 'www.ewa-gabinet.pl'">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>
  # pliki z hashem w nazwie (CSS, JS, zdjęcia z astro:assets) – można trzymać w przeglądarce rok
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # zdjęcia z public/img bez hasha (stare adresy z Google Grafiki) – 30 dni; OVH domyślnie dawało 15 min (Lighthouse 2026-11-14)
  <If "%{REQUEST_URI} =~ m#^/img/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
